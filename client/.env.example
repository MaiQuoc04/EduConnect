# Documents the client's build-time variables. Never commit .env.
#
# Development: no client/.env is needed. With both variables unset, the client calls /api/v1 and /socket.io on its
# own origin and the Vite proxy in vite.config.js forwards them to the API server on port 5000.
# Copying this file to .env as is does no harm: src/api/client.js and SocketContext.jsx treat an empty value the
# same as unset and fall back to the Vite proxy. Only fill them in when pointing the client at a remote API.
#
# Production (Vercel > Project > Settings > Environment Variables):
#   VITE_API_URL=https://api.<ten-mien>/api/v1
#   VITE_SOCKET_URL=https://api.<ten-mien>
#
# Vite embeds these values into the bundle at BUILD time. After changing them on Vercel you must REBUILD (redeploy);
# a restart does not pick up the new values.

# Base URL of the REST API, including /api/v1
VITE_API_URL=
# Origin of the Socket.io server (no path)
VITE_SOCKET_URL=
