# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Shared database on Aiven (values from Aiven console > Overview > Connection information)
# For your local MySQL: DB_HOST=127.0.0.1, DB_PORT=3306, DB_USER=root, DB_SSL=false
DB_HOST=educonnect-db-quockinhcan2009-6e70.i.aivencloud.com
DB_PORT=13478
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=educonnect
DB_SSL=true
# Path to the CA certificate downloaded from Aiven (relative to the server folder)
DB_SSL_CA=./certs/ca.pem

# Use a long random string (at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=8h
