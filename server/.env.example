# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Shared PostgreSQL database on Supabase (values from Supabase > Connect > Session pooler > View parameters)
# Ask the team lead for DB_PASSWORD. If you get "max clients reached", switch to the Transaction pooler: DB_PORT=6543
# For your local PostgreSQL: DB_HOST=127.0.0.1, DB_PORT=5432, DB_USER=postgres, DB_NAME=educonnect, DB_SSL=false
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.ybornmjftuxjpegroxqn
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
# Optional: path to the Supabase CA certificate (Database > Settings > SSL Configuration), relative to the server folder.
# Empty = the connection is still encrypted, but the server certificate is not verified.
DB_SSL_CA=
# Connections per developer; the Supabase Free pooler is shared by the whole team
DB_POOL_MAX=3

# Use a long random string (at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Email for password-reset OTP (UC-02). Leave SMTP_HOST empty in development: emails are printed to the console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail>, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduConnect <no-reply@educonnect.local>

# Folder for uploaded files (avatars…) when STORAGE_DRIVER is local
UPLOAD_DIR=./uploads

# File storage: local (default, files on this server's disk in UPLOAD_DIR) or supabase (Supabase Storage).
# Keep local for development and for tests on the throw-away database (scripts/dev-local-db.js), so the shared quota
# stays clean. With supabase, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are required or the server will not start.
STORAGE_DRIVER=local
# Supabase > Project Settings > API (Data API): Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# WARNING: the service_role key bypasses RLS on EVERY table – leaking it exposes the whole database, not only Storage.
# Server only: never send it to the client, never put it in a VITE_ variable, never log or commit it. Ask the team lead.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket names (see database/README-storage.md)
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_ATTACHMENTS=attachments
